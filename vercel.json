{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/actions/buy/:mint",
      "destination": "/api/actions/buy?mint=:mint"
    },
    {
      "source": "/b/:mint",
      "destination": "/b.html"
    }
  ],
  "headers": [
    {
      "source": "/actions.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, Content-Encoding, Accept-Encoding"
        },
        {
          "key": "X-Action-Version",
          "value": "2.4"
        },
        {
          "key": "X-Blockchain-Ids",
          "value": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/api/actions/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, Content-Encoding, Accept-Encoding"
        },
        {
          "key": "X-Action-Version",
          "value": "2.4"
        },
        {
          "key": "X-Blockchain-Ids",
          "value": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
        }
      ]
    }
  ]
}
